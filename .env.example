# ABWizard environment. Copy to .env.local for local dev; set in Vercel → Project → Settings → Environment Variables.
# Everything is optional: with no AI key, "Ask ABWizard" uses the offline Local Smart Query Parser.
# After changing variables on Vercel, REDEPLOY — Vercel only applies them to new deployments.

# --- AI provider: set ONE of these keys (server-side only; never exposed to the browser) ---
# Google Gemini (aistudio.google.com → Get API key). GOOGLE_API_KEY also works.
GEMINI_API_KEY=
# Anthropic Claude (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# If BOTH keys are set, Claude is used unless you choose explicitly:
# AI_PROVIDER=gemini        # or: anthropic

# Optional model overrides.
# GEMINI_MODEL=gemini-3.8-flash
# When the Gemini model is overloaded (503) or rate limited, these are tried in order for a new question
# (follow-ups stay on the model that started the conversation). Set to empty to disable.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-lite-latest
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Strongly recommended on a public URL: require this code (entered once on the Ask page) before
# /api/analyze will call the AI, so the deployment can't be used as a free relay for your key.
# ABWIZARD_ACCESS_CODE=
