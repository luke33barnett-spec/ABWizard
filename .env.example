# ABWizard environment. Copy to .env.local for local dev; set in Vercel → Project → Settings → Environment Variables.
# Everything is optional: without a key, "Ask ABWizard" uses the offline Local Smart Query Parser.

# Enables Claude text-to-SQL in Ask ABWizard (server-side only; never exposed to the browser).
ANTHROPIC_API_KEY=

# Model for /api/analyze (default: claude-sonnet-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Strongly recommended on a public URL: require this code (entered once in the Ask page) before
# /api/analyze will call Claude, so the deployment can't be used as a free relay for your key.
# ABWIZARD_ACCESS_CODE=
